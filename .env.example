# ── Core ──────────────────────────────────────────────────────────────────────
# Railway Postgres — `railway variables` on the Postgres service. There is no
# local database; see docs/CREDENTIALS.md. (Or skip this entirely and use
# `railway run pnpm …` to inject it, keeping one less credential on disk.)
DATABASE_URL=
NODE_ENV=development

# No model API key. Nothing in Familiar calls a model, so it runs without paid
# API credits.

# ── MCP server ────────────────────────────────────────────────────────────────
PORT=8080
# Exact https origin — no trailing slash, no bare IP. Must equal the AS `issuer`
# or discovery silently breaks.
PUBLIC_URL=https://pcl.example.com
# Signs issued access tokens and the OAuth state cookie. Must be at least 32
# characters and random; the service refuses to start on a shorter one.
#   openssl rand -base64 32
# (BETTER_AUTH_SECRET is accepted as a legacy alias — the AS was originally
# going to be built on better-auth; it is hand-rolled instead.)
AUTH_SECRET=
# The single identity allowed to use this brain (least privilege).
# Your identifier at the sign-in provider below. For Google (the default) that is
# your `sub` — a stable numeric string, NOT your email; `pnpm mint:google` prints
# it. Email is mutable; sub is not. Unsure? Sign in once: the refusal page names
# the subject you signed in as.
ALLOWED_SUBJECT=
# Who signs you in: google (default), github, or oidc. See docs/SELF-HOSTING.md,
# step 1b. The worker uses the Google client below for the calendar regardless.
AUTH_PROVIDER=
# github: an OAuth App with callback https://<host>/oauth/github/callback.
# ALLOWED_SUBJECT is your numeric user id (`gh api user --jq .id`), not your login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# oidc: Okta, Entra ID, Authentik, Keycloak… Callback https://<host>/oauth/oidc/callback.
# OIDC_ISSUER must equal the discovery document's `issuer` exactly (trailing slash too).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional: display name, extra scopes (default openid), and client_secret_post
# if the app is not set up for the default client_secret_basic.
OIDC_NAME=
OIDC_SCOPES=
OIDC_TOKEN_AUTH_METHOD=
# ── Owner (src/owner.ts). Neutral defaults when unset. ───────────────────────
# Whose preferences `how_i_work` and `note_preference` are about: the owner's
# entity name. Defaults to "Owner". Set it before first use — renaming later
# points preferences at a different entity.
PCL_SELF=
# Your own addresses or domains, comma-separated (me@example.com, example.com),
# so `brief` leaves you out of "who is this meeting with". Calendar rows Google
# marks as you are skipped regardless.
PCL_SELF_EMAILS=
# Your operating policy for `how_i_work`, one rule per line (quote it; "1. " and
# "- " prefixes are dropped), and a version label to bump when it changes.
# Unset, a short neutral policy applies (src/mcp/how-i-work.ts).
PCL_OPERATING_POLICY=
PCL_OPERATING_POLICY_VERSION=

# ── Ingestion credentials (worker holds these; see docs — a session-scoped MCP
#    connection is absent in a cron run and cannot be the ingestion path) ──────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Recommended: the OAuth app is User type "Internal" (Workspace), and the
# personal calendar is shared into the Workspace account — so ONE token reads
# both calendars, with no 7-day expiry. `pnpm mint:google work`
GOOGLE_REFRESH_TOKEN_WORK=

# Escape hatch only. Not needed on the recommended path, and a second External app
# would reintroduce the 7-day refresh-token expiry. See docs/CREDENTIALS.md.
GOOGLE_REFRESH_TOKEN_PERSONAL=
